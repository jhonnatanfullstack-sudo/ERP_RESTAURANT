# ============================================
# Entorno
# ============================================
NODE_ENV=development

# ============================================
# Backend
# ============================================
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ============================================
# Base de datos (PostgreSQL vía Docker)
# ============================================
DB_HOST=localhost
# 5433 (no 5432): el puerto 5432 del host ya lo usa un proyecto Docker distinto y no relacionado en esta máquina
DB_PORT=5433
DB_NAME=restaurant_erp
DB_USER=restaurant_erp
# Rol con el que se conecta la aplicación: sin SUPERUSER ni BYPASSRLS, para que las
# políticas de aislamiento entre empresas (RLS) realmente apliquen. Lo crea la migración
# RolAplicacionSinBypassRls a partir de DB_APP_PASSWORD. DB_USER/DB_PASSWORD (el dueño de
# las tablas) queda solo para ejecutar migraciones.
DB_APP_USER=restaurant_erp_app
DB_APP_PASSWORD=cambia-esta-clave
DB_PASSWORD=changeme
# true al conectar contra un Postgres gestionado (Neon, Supabase, RDS...), que exige TLS.
# false en Docker local, que no lo usa. No se infiere de NODE_ENV: un VPS con Postgres propio
# en producción puede seguir sin TLS, así que es una decisión explícita.
DB_SSL=false

# ============================================
# Autenticación (JWT)
# ============================================
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Consulta de DNI/RUC (apis.net.pe) — opcional
# ============================================
# Sin este token, el botón de búsqueda en el formulario de Personal
# muestra "servicio no configurado" pero el resto del sistema funciona igual.
# Obtener token en https://apis.net.pe (servicio ahora corre sobre decolecta.com)
APIS_NET_PE_TOKEN=
# APIS_NET_PE_BASE_URL=https://api.decolecta.com/v1

# Contacto del proveedor del sistema, mostrado al restaurante cuando su demo vence.
PROVEEDOR_NOMBRE=Jhonnatan Vasquez
PROVEEDOR_EMAIL=tu-correo@ejemplo.com
PROVEEDOR_TELEFONO=51900000000

# Duración de las cuentas de prueba creadas desde el registro público.
DEMO_DIAS_DE_PRUEBA=15

# ============================================
# Facturación electrónica SUNAT (FASE 28) — opcional
# ============================================
# Clave con la que se cifra en reposo el certificado digital y las credenciales del OSE de
# cada empresa. Sin ella, la facturación electrónica responde 503 pero el resto del sistema
# funciona igual. Debe decodificar a 32 bytes (AES-256): generar con
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CIFRADO_CLAVE=

# ============================================
# Despliegue (ver docs/despliegue.md)
# ============================================
# Proxies delante de la app. 0 en local; 1 en Render/Railway/Fly/Vercel — sin esto el
# limitador de peticiones ve la IP del balanceador y bloquea a todos los visitantes juntos.
TRUST_PROXY=0
# true cuando el frontend está en un dominio distinto al del backend (lo habitual al
# desplegar). Sin esto el navegador no envía la cookie de sesión y el usuario aparece
# deslogueado en cada recarga de página. Exige HTTPS en ambos lados.
COOKIE_CROSS_SITE=false
# Nivel mínimo de registro: debug | info | warn | error. En producción `info` deja fuera el
# detalle de cada petición correcta y conserva lo que importa.
LOG_LEVEL=info
