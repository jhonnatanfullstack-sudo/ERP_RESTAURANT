{
  "name": "restaurant-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web de gestión integral para restaurante",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev:backend": "pnpm --filter @restaurant-erp/backend dev",
    "dev:frontend": "pnpm --filter @restaurant-erp/frontend dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
